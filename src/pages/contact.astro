---
import Layout from '../layouts/Layout.astro';

const email = "gihedaloui@gmail.com";
const linkedinUrl = "https://www.linkedin.com/in/jihed-aloui";
const githubUrl = "https://github.com/jihed01";
const location = "Paris, France";
const cvPath = "/cv.pdf";
---

<Layout title="Contact & CV — Jihed | Ingénieure IA">
  <section class="max-w-4xl mx-auto px-6 py-12 space-y-12">
    
    <!-- En-tête -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Disponible pour opportunités AI Engineer / R&D
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">
        Contact & Curriculum Vitae
      </h1>
      <p class="text-zinc-400 text-base md:text-lg max-w-2xl leading-relaxed">
        Laissez-moi un message directement ci-dessous ou téléchargez mon CV.
      </p>
    </div>

    <!-- Grille : Formulaire de contact (à gauche) + CV (à droite) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Colonne Formulaire & Réseaux -->
      <div class="space-y-6 md:col-span-1">
        
        <!-- Formulaire de Message Direct -->
        <div class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/50 space-y-4">
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            ✉️ Envoyer un message
          </h2>
          
          <form 
            action="https://formsubmit.co/gihedaloui@gmail.com" 
            method="POST" 
            class="space-y-3"
          >
            <!-- Paramètres FormSubmit -->
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_template" value="table">
            <input type="hidden" name="_subject" value="Nouveau message depuis votre Portfolio IA !">
            
            <!-- Redirection vers votre page après l'envoi pour éviter le 404 -->
            <input type="hidden" name="_next" value="https://portfolio-website-jihed.vercel.app/contact">

            <div>
              <label for="name" class="block text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-1">Votre Nom</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                placeholder="Ex: Marie Curie"
                class="w-full px-3 py-2 rounded-lg bg-zinc-950 border border-zinc-800 text-white text-xs focus:outline-none focus:border-emerald-500 transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-1">Votre E-mail</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="nom@exemple.com"
                class="w-full px-3 py-2 rounded-lg bg-zinc-950 border border-zinc-800 text-white text-xs focus:outline-none focus:border-emerald-500 transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-1">Message</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Bonjour Jihed, j'aimerais échanger sur..."
                class="w-full px-3 py-2 rounded-lg bg-zinc-950 border border-zinc-800 text-white text-xs focus:outline-none focus:border-emerald-500 transition-colors resize-none"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold text-xs transition-colors cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Envoyer le message 🚀</span>
            </button>
          </form>
        </div>

        <!-- Profils Pro -->
        <div class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/50 space-y-3">
          <h2 class="text-sm font-bold text-white">Réseaux Professionnels</h2>
          <div class="space-y-2 text-xs">
            <a 
              href={linkedinUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-800/60 hover:bg-zinc-800 text-zinc-200 transition-colors"
            >
              <span>LinkedIn</span>
              <span class="text-emerald-400 font-mono">in/jihed-aloui →</span>
            </a>
            <a 
              href={githubUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-800/60 hover:bg-zinc-800 text-zinc-200 transition-colors"
            >
              <span>GitHub</span>
              <span class="text-emerald-400 font-mono">github.com/jihed01 →</span>
            </a>
          </div>
        </div>

        <!-- Localisation -->
        <div class="p-3.5 rounded-xl border border-zinc-800 bg-zinc-900/30 text-xs text-zinc-400 flex items-center gap-2.5">
          <span>📍</span>
          <div>
            <p class="font-semibold text-white">Basée à {location}</p>
            <p class="text-zinc-500 text-[11px]">Télétravail & déplacements</p>
          </div>
        </div>

      </div>

      <!-- Colonne Prévisualisation & Téléchargement CV -->
      <div class="space-y-6 md:col-span-2">
        <div class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/50 space-y-6">
          
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-zinc-800 pb-4">
            <div>
              <h2 class="text-xl font-bold text-white">Curriculum Vitae</h2>
              <p class="text-xs text-zinc-400 mt-1">Format PDF</p>
            </div>

            <!-- Boutons Téléchargement / Plein écran -->
            <div class="flex items-center gap-3 w-full sm:w-auto">
              <a 
                href={cvPath} 
                download="CV_Jihed_Aloui_AI_Engineer.pdf"
                class="flex-1 sm:flex-none text-center px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 text-xs font-bold transition-colors"
              >
                📥 Télécharger PDF
              </a>
              <a 
                href={cvPath} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="flex-1 sm:flex-none text-center px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-medium transition-colors"
              >
                🔗 Plein écran
              </a>
            </div>
          </div>

          <!-- Affichage du PDF intégré -->
          <div class="w-full h-[520px] rounded-xl border border-zinc-800 overflow-hidden bg-zinc-950">
            <iframe 
              src={cvPath} 
              class="w-full h-full border-0" 
              title="Aperçu du CV de Jihed Aloui"
            >
              <p class="text-xs text-zinc-400 p-6 text-center">
                Votre navigateur ne prend pas en charge la prévisualisation. 
                <a href={cvPath} download class="text-emerald-400 underline">Cliquez ici pour télécharger le CV</a>.
              </p>
            </iframe>
          </div>

        </div>
      </div>

    </div>

  </section>
</Layout>