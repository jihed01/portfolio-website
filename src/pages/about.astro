---
import Layout from '../layouts/Layout.astro';

const profile = {
  title: "Candidate Doctorat CIFRE — LLM, Intelligence Documentaire & MRO",
  subtitle: "Machine Learning Engineer | RAG, Multimodalité, Traçabilité & Explicabilité IA",
  location: "Île-de-France, France",
  summary: "Ingénieure Bac+5 spécialisée en modèles de langage (LLM) et intelligence documentaire, avec une expérience confirmée en OCR multimodal, RAG (Retrieval-Augmented Generation) et industrialisation de solutions IA pour des documents techniques critiques. Particulièrement axée sur les verrous scientifiques des LLM : réduction des hallucinations, traçabilité des sources, explicabilité et fusion de données hétérogènes (texte/image) en environnements industriels réglementés (MRO, documentation de maintenance)."
};

const skillCategories = [
  {
    name: "Intelligence Artificielle & LLM",
    skills: ["LLM (GPT, LLaMA, Mistral)", "Retrieval-Augmented Generation (RAG)", "Réduction des hallucinations", "Raisonnement multi-étapes (Chain-of-Thought)", "Prompt Engineering & Fine-tuning", "Explicabilité & Traçabilité (Citation)"]
  },
  {
    name: "Intelligence Documentaire & Multimodalité",
    skills: ["OCR Multimodal (Texte & Image)", "Extraction de docs techniques", "Fusion de données hétérogènes", "Recherche d'information industrielle"]
  },
  {
    name: "Développement & MLOps",
    skills: ["Python", "FastAPI / Flask", "PyTorch / TensorFlow", "Docker & CI/CD (GitHub Actions)", "AWS (S3, EC2, SageMaker)", "Apache Airflow", "SQL / DuckDB / SPARQL / XML"]
  }
];

const experiences = [
  {
    role: "Machine Learning Engineer",
    company: "AOSORA",
    location: "Paris, France",
    period: "Mai 2024 – Novembre 2025",
    description: "Conception et déploiement d'un système d'intelligence documentaire multimodal pour l'extraction et la validation de documents techniques et d'identité critiques.",
    achievements: [
      "Développement de pipelines OCR hybrides (PyTesseract, EasyOCR, Mindee API) pour l'extraction structurée de champs complexes.",
      "Mise en place de mécanismes de réduction des erreurs et faux positifs (hallucinations des modèles IA).",
      "Prétraitement avancé d'images (OpenCV) réduisant les échecs d'extraction de 40%.",
      "Développement d'APIs backend (FastAPI/Flask) et intégration CI/CD.",
      "Approche transposable à la documentation MRO (schémas, notices, procédures) en secteur réglementé."
    ],
    stack: ["Python", "FastAPI", "Flask", "OpenCV", "PyTesseract", "EasyOCR", "Mindee API", "Docker", "CI/CD", "Linux"]
  },
  {
    role: "Ingénieur R&D en Deep Learning",
    company: "Institut de Recherche en Informatique de Toulouse (IRIT)",
    location: "Toulouse, France",
    period: "Mai 2023 – Septembre 2023",
    description: "Recherche appliquée sur des modèles génératifs pour l'analyse et l'extraction de signaux dans des simulations physiques complexes.",
    achievements: [
      "Optimisation d'architectures U-Net et PatchGAN (Pix2Pix) avec validation expérimentale rigoureuse (PSNR, SSIM, FID).",
      "Collaboration avec des chercheurs académiques pour l'analyse des résultats et la préparation de publications scientifiques.",
      "Mise en place d'une méthodologie de recherche rigoureuse orientée reproductibilité pour des travaux de thèse."
    ],
    stack: ["Python", "PyTorch", "TensorFlow", "GANs", "CNN", "Transformers", "Jupyter", "Linux"]
  },
  {
    role: "Robotics & Artificial Intelligence Engineer",
    company: "SIMFEC Conseil",
    location: "Tunis, Tunisie",
    period: "Août 2019 – Août 2022",
    description: "Conception et développement de prototypes robotiques intégrant des systèmes d'IA embarquée pour la surveillance, la navigation autonome et les UAVs.",
    achievements: [
      "Implémentation d'algorithmes de ML et vision (détection d'objets, SLAM, planification) pour la prise de décision en temps réel.",
      "Intégration matériel/logiciel au sein de systèmes embarqués soumis à des contraintes industrielles critiques.",
      "Animation de formations techniques clients sur l'IA, le Machine Learning et la robotique."
    ],
    stack: ["Python", "OpenCV", "ROS", "TensorFlow", "PyTorch", "Embedded Linux", "C/C++", "MATLAB"]
  },
  {
    role: "Enseignante en Informatique & IA",
    company: "SUPTECH University",
    location: "Tunis, Tunisie",
    period: "Août 2019 – Août 2022",
    description: "Enseignement universitaire en Licence Informatique : Intelligence Artificielle, Traitement d'image, Traitement du signal, Python et C.",
    achievements: [
      "Vulgarisation technique et pédagogie pour la transmission de concepts complexes.",
      "Management transversal de projets académiques multidisciplinaires."
    ],
    stack: ["Python", "C", "Traitement d'image", "Traitement du signal", "IA"]
  }
];

const education = [
  {
    degree: "Master 2 Signal, Image et Machine Learning",
    institution: "Université Paul Sabatier (Toulouse III)",
    year: "2023"
  },
  {
    degree: "Master 2 Mathématiques & Informatique – Images Multimédia",
    institution: "Université Paris Cité (ex-Descartes)",
    year: "2018 – 2019",
    mobility: "🇸🇪 Échange Erasmus+ (1 an) — Uppsala University, Suède"
  },
  {
    degree: "Diplôme National d'Ingénieur en Mécatronique (Robotique)",
    institution: "ENI Carthage",
    year: "2016"
  },
  {
    degree: "Programme Data Upskilling (200h+)",
    institution: "Formation Continue",
    year: "2025",
    skills: ["Python Pro", "FastAPI", "SQL", "Airflow", "Linux", "Git"]
  }
];

const certifications = [
  { name: "MLOps: Machine Learning in Production", provider: "DeepLearning.AI", status: "En cours" },
  { name: "AWS Cloud Technical Essentials", provider: "Amazon", year: "2024" },
  { name: "Machine Learning & GANs Specializations", provider: "DeepLearning.AI / Stanford", year: "Certifiée" }
];
---

<Layout title="À Propos — Jihed Aloui | Candidate Doctorat CIFRE">
  <section class="max-w-4xl mx-auto px-6 py-12 space-y-16">
    
    <!-- En-tête Profil -->
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20">
        Profil Recherche Appliquée & Industrie
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Jihed Aloui
      </h1>
      <p class="text-lg md:text-xl text-emerald-400 font-medium">
        {profile.title}
      </p>
      <p class="text-zinc-400 text-base md:text-lg leading-relaxed">
        {profile.summary}
      </p>
    </div>

    <!-- Compétences Clés -->
    <div class="space-y-6">
      <h2 class="text-2xl font-bold text-white border-b border-zinc-800 pb-3">
        Compétences & Domaines d'Expertise
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {skillCategories.map((cat) => (
          <div class="p-5 rounded-2xl border border-zinc-800 bg-zinc-900/40 space-y-3">
            <h3 class="text-sm font-bold text-emerald-400 uppercase tracking-wider">
              {cat.name}
            </h3>
            <ul class="space-y-2">
              {cat.skills.map((skill) => (
                <li class="text-xs text-zinc-300 flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Expériences Professionnelles -->
    <div class="space-y-8">
      <h2 class="text-2xl font-bold text-white border-b border-zinc-800 pb-3">
        Parcours Professionnel
      </h2>
      <div class="space-y-6">
        {experiences.map((exp) => (
          <div class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/50 space-y-4 hover:border-zinc-700 transition-all">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 border-b border-zinc-800/60 pb-3">
              <div>
                <h3 class="text-lg font-bold text-white">{exp.role}</h3>
                <p class="text-sm text-emerald-400 font-medium">{exp.company} — <span class="text-zinc-400">{exp.location}</span></p>
              </div>
              <span class="px-3 py-1 rounded-md bg-zinc-800 text-zinc-300 text-xs font-mono shrink-0 self-start md:self-auto">
                {exp.period}
              </span>
            </div>

            <p class="text-sm text-zinc-300 leading-relaxed">
              {exp.description}
            </p>

            <ul class="space-y-1.5 pl-4 list-disc text-xs text-zinc-400">
              {exp.achievements.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-2 pt-2">
              {exp.stack.map((tech) => (
                <span class="px-2 py-0.5 rounded bg-zinc-800/80 text-zinc-300 text-xs font-mono border border-zinc-700/40">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Formation & Certifications -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Formation -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-white border-b border-zinc-800 pb-3">
          Diplômes & Formation
        </h2>
        <div class="space-y-4">
          {education.map((edu) => (
            <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-900/30 space-y-1">
              <div class="flex justify-between items-start gap-2">
                <h3 class="text-sm font-bold text-white">{edu.degree}</h3>
                <span class="text-xs font-mono text-zinc-400 bg-zinc-800 px-2 py-0.5 rounded shrink-0">{edu.year}</span>
              </div>
              
              <p class="text-xs text-zinc-400">{edu.institution}</p>

              {edu.mobility && (
                <p class="text-xs text-emerald-400 font-medium pt-0.5">
                  {edu.mobility}
                </p>
              )}

              {edu.skills && (
                <div class="flex flex-wrap gap-1 pt-2">
                  {edu.skills.map((s) => (
                    <span class="text-[10px] font-mono bg-zinc-800/80 text-zinc-300 px-1.5 py-0.5 rounded">{s}</span>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Certifications -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-white border-b border-zinc-800 pb-3">
          Certifications
        </h2>
        <div class="space-y-4">
          {certifications.map((cert) => (
            <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-900/30 flex justify-between items-center gap-2">
              <div>
                <h3 class="text-sm font-bold text-white">{cert.name}</h3>
                <p class="text-xs text-emerald-400">{cert.provider}</p>
              </div>
              <span class="text-xs font-mono text-zinc-400 bg-zinc-800 px-2 py-0.5 rounded shrink-0">
                {cert.year || cert.status}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </section>
</Layout>