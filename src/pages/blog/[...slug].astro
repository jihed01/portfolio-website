---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map(entry => ({
    params: { slug: entry.id }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title ?? 'Article'} — Blog`}>
  <article class="max-w-3xl mx-auto px-6 py-12 space-y-8">
    <a href="/blog" class="inline-flex items-center gap-1 text-xs text-emerald-400 hover:underline">
      ← Retour aux articles
    </a>
    
    <header class="space-y-3 border-b border-zinc-800 pb-6">
      <h1 class="text-2xl md:text-4xl font-extrabold text-white">
        {entry.data.title}
      </h1>
      {entry.data.pubDate && (
        <p class="text-xs text-zinc-500">
          Publié le {new Date(entry.data.pubDate).toLocaleDateString('fr-FR')}
        </p>
      )}
    </header>

    <div class="text-zinc-300 text-sm leading-relaxed space-y-4">
      <Content />
    </div>
  </article>
</Layout>