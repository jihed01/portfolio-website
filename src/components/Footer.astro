---
const currentYear = new Date().getFullYear();

const email = "gihedaloui@gmail.com";
const location = "Paris, France";

// Pseudos / handles
const githubUser = "jihed01";
const githubUrl = `https://github.com/${githubUser}`;

const linkedinUser = "jihed-aloui";
const linkedinUrl = `https://www.linkedin.com/in/${linkedinUser}`;

const huggingfaceUser = "jihed01";
const huggingfaceUrl = `https://huggingface.co/${huggingfaceUser}`;
---

<footer class="border-t border-zinc-800 bg-zinc-950 text-zinc-400 py-12 px-6 mt-20 w-full">
  <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
    
    <!-- Colonne 1 : Branding -->
    <div class="flex flex-col gap-3">
      <a href="/" class="text-white font-bold text-lg hover:text-emerald-400 transition-colors">
        Jihed<span class="text-emerald-400">.ai</span>
      </a>
      <p class="text-sm text-zinc-400 leading-relaxed">
        Ingénieure IA spécialisée en Document Intelligence, Visual RAG et Computer Vision.
      </p>
      <p class="text-xs text-zinc-500">📍 {location}</p>
    </div>

    <!-- Colonne 2 : Navigation avec Blog -->
    <div>
      <h3 class="text-xs font-semibold text-white tracking-wider uppercase mb-4">Navigation</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/" class="hover:text-emerald-400 transition-colors">Accueil</a></li>
        <li><a href="/about" class="hover:text-emerald-400 transition-colors">À propos</a></li>
        <li><a href="/projects" class="hover:text-emerald-400 transition-colors">Projets</a></li>
        <li><a href="/blog" class="hover:text-emerald-400 transition-colors">Blog</a></li>
        <li><a href="/contact" class="hover:text-emerald-400 transition-colors">Contact & CV</a></li>
      </ul>
    </div>

    <!-- Colonne 3 : Contact & Réseaux avec icônes SVG -->
    <div>
      <h3 class="text-xs font-semibold text-white tracking-wider uppercase mb-4">Réseaux & Contact</h3>
      <ul class="space-y-3 text-sm">
        <li>
          <a href={`mailto:${email}`} class="inline-flex items-center gap-2.5 text-emerald-400 hover:underline font-mono text-xs truncate">
            <svg width="16" height="16" class="w-4 h-4 shrink-0 stroke-current" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span>{email}</span>
          </a>
        </li>
        <li>
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 text-emerald-400 hover:underline font-mono text-xs truncate">
            <svg width="16" height="16" class="w-4 h-4 shrink-0 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>github.com/{githubUser}</span>
          </a>
        </li>
        <li>
          <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 text-emerald-400 hover:underline font-mono text-xs truncate">
            <svg width="16" height="16" class="w-4 h-4 shrink-0 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.48 1.48 0 1 0 0 2.95 1.48 1.48 0 0 0 0-2.95z"/>
            </svg>
            <span>in/{linkedinUser}</span>
          </a>
        </li>
        <li>
          <a href={huggingfaceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 text-emerald-400 hover:underline font-mono text-xs truncate">
            <svg width="16" height="16" class="w-4 h-4 shrink-0 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2A10 10 0 0 0 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8.009 8.009 0 0 1-8 8zm-3.5-9a1.5 1.5 0 1 0-1.5-1.5A1.5 1.5 0 0 0 8.5 11zm7 0a1.5 1.5 0 1 0-1.5-1.5 1.5 1.5 0 0 0 1.5 1.5zm-7.23 3.27a1 1 0 0 0 1.41 1.42 4.93 4.93 0 0 0 6.64 0 1 1 0 0 0 1.41-1.42 6.93 6.93 0 0 1-9.46 0z"/>
            </svg>
            <span>hf.co/{huggingfaceUser}</span>
          </a>
        </li>
      </ul>
    </div>

  </div>

  <!-- Copyright -->
  <div class="max-w-5xl mx-auto pt-8 border-t border-zinc-900 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-zinc-500">
    <p>© {currentYear} Jihed. Tous droits réservés.</p>
    <p>Conçu avec <span class="text-zinc-300">Astro</span> & <span class="text-zinc-300">Tailwind CSS</span></p>
  </div>
</footer>