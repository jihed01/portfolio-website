---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('blog');
articles.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// 🟢 LIGNE DE DÉBOGAGE :
console.log("ARTICLES TROUVÉS :", articles);
---

<Layout title="Blog & Articles — Jihed | Ingénieure IA">
  <section class="max-w-4xl mx-auto px-6 py-12 space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl md:text-5xl font-extrabold text-white">Articles & Publications</h1>
      <p class="text-zinc-400 text-sm md:text-base">
        Analyses techniques, tutoriels et retours d'expérience sur l'Ingénierie IA.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {articles.map((article) => (
        <a 
          href={`/blog/${article.id}`} 
          class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/50 hover:border-emerald-500/50 transition-colors space-y-3 block"
        >
          <span class="text-[11px] font-mono text-emerald-400">
            {new Date(article.data.pubDate).toLocaleDateString('fr-FR')}
          </span>
          <h2 class="text-lg font-bold text-white hover:text-emerald-400 transition-colors">
            {article.data.title}
          </h2>
          <p class="text-xs text-zinc-400 line-clamp-2 leading-relaxed">
            {article.data.description}
          </p>
        </a>
      ))}
    </div>
  </section>
</Layout>