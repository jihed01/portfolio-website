---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "Doc Image Normalizer",
    category: "Computer Vision / Preprocessing",
    metrics: "CER -15.4% | Latence < 120ms",
    description: "Pipeline de restauration d'images de documents dégradés. Correction d'homographie, binarisation adaptative et déparasitage haute performance.",
    tags: ["OpenCV", "FastAPI", "Pytest", "Docker"],
    github: "https://github.com/jihed01/doc-image-normalizer",
    demo: "#"
  },
  {
    title: "Invoice KIE LayoutLMv3",
    category: "Document Understanding",
    metrics: "F1-Score 89.2%",
    description: "Fine-tuning de LayoutLMv3 pour l'extraction automatique et structurée de paires clé-valeur sur des factures denses et multi-formats.",
    tags: ["LayoutLMv3", "PyTorch", "Hugging Face", "Pydantic"],
    github: "https://github.com/jihed01/invoice-kie-layoutlmv3",
    demo: null
  },
  {
    title: "ColPali Visual RAG",
    category: "Visual RAG & Multimodal",
    metrics: "Hit Rate@3: 92%",
    description: "Implémentation d'un moteur de recherche sémantique multimodal basé sur ColPali pour interroger des documents scannés sans passer par un OCR.",
    tags: ["ColPali", "Qdrant", "vLLM", "LangChain"],
    github: "https://github.com/jihed01/colpali-visual-rag",
    demo: "#"
  },
  {
    title: "Donut OCR-Free Parser",
    category: "End-to-End Parsing",
    metrics: "JSON Structuré",
    description: "Modèle de parsing de documents de type OCR-free transformant directement des images de rapports complexes en objets JSON typés.",
    tags: ["Donut", "Transformers", "PyTorch", "FastAPI"],
    github: "https://github.com/jihed01/donut-ocr-parser",
    demo: null
  },
  {
    title: "Pipeline ETL & Analytics Trafic Retail",
    category: "Data Engineering / Analytics",
    metrics: "Anomalies ±50% | Parquet",
    description: "Pipeline de données complète pour l'analyse en temps réel du trafic en magasin, détection d'anomalies (±50%) et dashboard Streamlit.",
    tags: ["Python", "Pandas", "FastAPI", "Streamlit", "Airflow", "Parquet"],
    github: "https://github.com/jihed01/Data-pipeline",
    demo: "https://share.streamlit.io/jihed01/Data-pipeline"
  }
];
---

<Layout title="Projets — Jihed | Ingénieure IA">
  <section class="max-w-4xl mx-auto px-6 py-12 space-y-12">
    
    <!-- En-tête de la page -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20">
        Portfolio Technique
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">
        Projets Vitrines & Réalisations
      </h1>
      <p class="text-zinc-400 text-base md:text-lg max-w-2xl leading-relaxed">
        Sélection de pipelines industriels, de modèles multimodaux fine-tunés et de services d'inférence orientés production.
      </p>
    </div>

    <!-- Grille des Projets -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <div class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/50 flex flex-col justify-between hover:border-zinc-700 transition-all group">
          
          <div class="space-y-4">
            <div class="flex justify-between items-center text-xs">
              <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 font-medium border border-emerald-500/20">
                {project.category}
              </span>
              <span class="font-mono text-zinc-400 font-semibold">{project.metrics}</span>
            </div>

            <div>
              <h2 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors">
                {project.title}
              </h2>
              <p class="text-sm text-zinc-400 mt-2 leading-relaxed">
                {project.description}
              </p>
            </div>

            <!-- Tags techniques -->
            <div class="flex flex-wrap gap-2 pt-2">
              {project.tags?.map((tag) => (
                <span class="px-2.5 py-1 rounded-md bg-zinc-800 text-zinc-300 text-xs font-mono">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Liens d'action -->
          <div class="pt-6 mt-6 border-t border-zinc-800/80 flex items-center gap-6 text-sm">
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-white hover:text-emerald-400 font-medium transition-colors flex items-center gap-1.5">
                Code GitHub →
              </a>
            )}
            {project.demo && (
              <a href={project.demo} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline font-medium flex items-center gap-1.5">
                Démo Live ⚡
              </a>
            )}
          </div>

        </div>
      ))}
    </div>

    <!-- Section MLOps / Stack -->
    <div class="p-8 rounded-2xl bg-zinc-900/30 border border-zinc-800/80 space-y-4">
      <h2 class="text-lg font-bold text-white">Stack & Bonnes Pratiques MLOps</h2>
      <p class="text-sm text-zinc-400 leading-relaxed">
        Chaque dépôt intègre des tests unitaires automatisés via <code class="text-emerald-400">Pytest</code>, une gestion stricte des types avec <code class="text-emerald-400">Pydantic v2</code>, et un packaging conteneurisé sous <code class="text-emerald-400">Docker</code> optimisé pour l'inférence GPU/CPU en environnements de production.
      </p>
    </div>

  </section>
</Layout>