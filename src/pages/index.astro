---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout title="Portfolio AI Engineer | Document AI & Vision">
  <main class="bg-zinc-950 min-h-screen text-zinc-100 px-6 py-12 max-w-5xl mx-auto">
    
    <!-- Hero Section -->
    <section class="mb-16">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Ingénieure IA — <span class="text-emerald-400">Document AI & Vision</span>
      </h1>
      <p class="text-lg text-zinc-400 max-w-2xl leading-relaxed">
        Spécialisée dans la conception de pipelines d'extraction complexe, l'OCR-Free Parsing (Donut/VLM), le RAG visuel (ColPali) et le déploiement d'agents documentaires.
      </p>
    </section>

    <!-- Projets Section -->
    <section id="projets" class="mb-16">
      <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
        Projets Vitrines Industriels
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

  </main>
</Layout>
